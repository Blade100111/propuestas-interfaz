{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "propuestas-interfaz": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-builders/custom-webpack:browser",
          "options": {
            "outputPath": "dist",
            "main": "src/main.single-spa.ts",
            "index": "src/index.html",
            "baseHref": "",
            "tsConfig": "tsconfig.app.json",
            "allowedCommonJsDependencies": ["pdfmake", "pdfmake/build/fonts/Roboto"],
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "customWebpackConfig": {
              "path": "extra-webpack.config.js",
              "libraryName": "propuestas-interfaz",
              "libraryTarget": "umd"
            }
          },
          "configurations": {
            "production": {
              "outputHashing": "none"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "outputHashing": "none"
            },
            "local": {
              "optimization": false,
              "sourceMap": true,
              "namedChunks": true,
              "outputHashing": "none",
              "deployUrl": "http://localhost:4204/"
            }
          },
          "defaultConfiguration": "local"
        },
        "serve": {
          "builder": "@angular-builders/custom-webpack:dev-server",
          "options": {
            "port": 4204,
            "publicHost": "http://localhost:4204"
          },
          "configurations": {
            "production": {
              "buildTarget": "propuestas-interfaz:build:production"
            },
            "development": {
              "buildTarget": "propuestas-interfaz:build:development"
            },
            "local": {
              "buildTarget": "propuestas-interfaz:build:local"
            }
          },
          "defaultConfiguration": "local"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
